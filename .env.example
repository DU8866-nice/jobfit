# Copy this file to .env and fill in what you need. Never commit .env.

# AI provider: set ONE key. With no key the app runs in offline demo mode (keyword matching).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Force a provider when both keys are set: anthropic | deepseek | mock
# JOBFIT_PROVIDER=

# Override model names. Defaults: Claude = claude-haiku-5-5 (extract) + claude-sonnet-5-5 (match);
# DeepSeek = deepseek-flash for both.
# JOBFIT_EXTRACT_MODEL=
# JOBFIT_MATCH_MODEL=

# Claude only: thinking effort per step (low | medium | high | xhigh | max)
# JOBFIT_EXTRACT_EFFORT=low
# JOBFIT_MATCH_EFFORT=medium

# Cost guards. 0 turns a limit off.
# JOBFIT_RATE_LIMIT_PER_HOUR=10
# JOBFIT_DAILY_ANALYSIS_LIMIT=200

# Only needed if the frontend is served from a different origin than the API.
# JOBFIT_CORS_ORIGINS=http://localhost:5173
